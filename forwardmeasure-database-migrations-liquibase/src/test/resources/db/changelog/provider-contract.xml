<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001-create-widget" author="forwardmeasure">
        <createTable tableName="migration_widget">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)"/>
        </createTable>
    </changeSet>
    <changeSet id="002-seed-widget" author="forwardmeasure" context="seed">
        <insert tableName="migration_widget">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="${widgetName}"/>
        </insert>
    </changeSet>
    <changeSet id="003-premium-table" author="forwardmeasure" labels="premium">
        <createTable tableName="premium_widget">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>

